<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RGMS.Lib</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    NI-DAQmx managed assemblies are not on nuget.org; they ship with the NI-DAQmx driver installer (Windows only).
    Override $(NIDAQmxAssemblyPath) on the Windows build machine if the assemblies live somewhere non-default.
    Typical locations after a recent NI-DAQmx driver install:
      C:\Program Files (x86)\National Instruments\MeasurementStudioVS2022\DotNET\Assemblies\Current
      C:\Program Files (x86)\National Instruments\Shared\ExternalCompilerSupport\C\references\NetCore
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' AND '$(TargetFramework)' == 'net8.0-windows'">
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND '$(NIDAQMX_ASSEMBLY_PATH)' != ''">$(NIDAQMX_ASSEMBLY_PATH)</NIDAQmxAssemblyPath>

    <_NICand1>$(ProgramFiles) (x86)\National Instruments\MeasurementStudioVS2022\DotNET\Assemblies\Current</_NICand1>
    <_NICand2>$(ProgramFiles) (x86)\National Instruments\MeasurementStudioVS2019\DotNET\Assemblies\Current</_NICand2>
    <_NICand3>$(ProgramFiles) (x86)\National Instruments\MeasurementStudioVS2012\DotNET\Assemblies (64-bit)\Current</_NICand3>
    <_NICand4>$(ProgramFiles) (x86)\National Instruments\MeasurementStudioVS2012\DotNET\Assemblies\Current</_NICand4>
    <_NICand5>$(ProgramFiles) (x86)\National Instruments\MeasurementStudioVS2010\DotNET\Assemblies (64-bit)\Current</_NICand5>
    <_NICand6>$(ProgramFiles) (x86)\National Instruments\MeasurementStudioVS2010\DotNET\Assemblies\Current</_NICand6>
    <_NICand7>$(ProgramFiles) (x86)\National Instruments\Shared\DotNET\Assemblies\Current</_NICand7>

    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand1)\NationalInstruments.DAQmx.dll')">$(_NICand1)</NIDAQmxAssemblyPath>
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand2)\NationalInstruments.DAQmx.dll')">$(_NICand2)</NIDAQmxAssemblyPath>
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand3)\NationalInstruments.DAQmx.dll')">$(_NICand3)</NIDAQmxAssemblyPath>
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand4)\NationalInstruments.DAQmx.dll')">$(_NICand4)</NIDAQmxAssemblyPath>
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand5)\NationalInstruments.DAQmx.dll')">$(_NICand5)</NIDAQmxAssemblyPath>
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand6)\NationalInstruments.DAQmx.dll')">$(_NICand6)</NIDAQmxAssemblyPath>
    <NIDAQmxAssemblyPath Condition="'$(NIDAQmxAssemblyPath)' == '' AND Exists('$(_NICand7)\NationalInstruments.DAQmx.dll')">$(_NICand7)</NIDAQmxAssemblyPath>

    <NIDAQmxAvailable Condition="'$(NIDAQmxAssemblyPath)' != '' AND Exists('$(NIDAQmxAssemblyPath)\NationalInstruments.DAQmx.dll')">true</NIDAQmxAvailable>
    <NIDAQmxAvailable Condition="'$(NIDAQmxAvailable)' == ''">false</NIDAQmxAvailable>

    <_NICommonC1>$(NIDAQmxAssemblyPath)</_NICommonC1>
    <_NICommonC2>$(ProgramFiles) (x86)\National Instruments\Measurement Studio\DotNET\v4.0\AnyCPU\NationalInstruments.Common 19.1.40</_NICommonC2>
    <_NICommonC3>$(ProgramFiles) (x86)\National Instruments\Measurement Studio\DotNET\v4.0\AnyCPU\NationalInstruments.Common 19.0.40</_NICommonC3>
    <_NICommonC4>$(ProgramFiles) (x86)\National Instruments\Shared\DotNET\Assemblies\Current</_NICommonC4>

    <NIDAQmxCommonPath Condition="'$(NIDAQmxCommonPath)' == '' AND Exists('$(_NICommonC1)\NationalInstruments.Common.dll')">$(_NICommonC1)</NIDAQmxCommonPath>
    <NIDAQmxCommonPath Condition="'$(NIDAQmxCommonPath)' == '' AND Exists('$(_NICommonC2)\NationalInstruments.Common.dll')">$(_NICommonC2)</NIDAQmxCommonPath>
    <NIDAQmxCommonPath Condition="'$(NIDAQmxCommonPath)' == '' AND Exists('$(_NICommonC3)\NationalInstruments.Common.dll')">$(_NICommonC3)</NIDAQmxCommonPath>
    <NIDAQmxCommonPath Condition="'$(NIDAQmxCommonPath)' == '' AND Exists('$(_NICommonC4)\NationalInstruments.Common.dll')">$(_NICommonC4)</NIDAQmxCommonPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NIDAQmxAvailable)' == ''">
    <NIDAQmxAvailable>false</NIDAQmxAvailable>
  </PropertyGroup>

  <Target Name="ReportNIDAQmxStatus" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Message Condition="'$(NIDAQmxAvailable)' == 'true'" Importance="high" Text="NI-DAQmx: referencing DAQmx from $(NIDAQmxAssemblyPath)" />
    <Message Condition="'$(NIDAQmxAvailable)' == 'true' AND '$(NIDAQmxCommonPath)' != ''" Importance="high" Text="NI-DAQmx: referencing Common from $(NIDAQmxCommonPath)" />
    <Message Condition="'$(NIDAQmxAvailable)' == 'true' AND '$(NIDAQmxCommonPath)' == ''" Importance="high" Text="NI-DAQmx: WARNING - NationalInstruments.Common.dll not found. Set NIDAQmxCommonPath to the directory containing it." />
    <Message Condition="'$(NIDAQmxAvailable)' != 'true'" Importance="high" Text="NI-DAQmx: assemblies NOT found (NI_DAQMX undefined; simulator path used). Set NIDAQmxAssemblyPath or env NIDAQMX_ASSEMBLY_PATH to override." />
  </Target>

  <PropertyGroup Condition="'$(NIDAQmxAvailable)' == 'true'">
    <DefineConstants>$(DefineConstants);NI_DAQMX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Copy NI assemblies to output: .NET 8 does not use the GAC, so without Private=true
    the runtime cannot locate NationalInstruments.DAQmx.dll and DaqSystem.Local.Devices
    fails with FileNotFoundException (or, when wrapped, the device list silently appears empty).
  -->
  <ItemGroup Condition="'$(NIDAQmxAvailable)' == 'true'">
    <Reference Include="NationalInstruments.DAQmx">
      <HintPath>$(NIDAQmxAssemblyPath)\NationalInstruments.DAQmx.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NationalInstruments.Common">
      <HintPath>$(NIDAQmxCommonPath)\NationalInstruments.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude the real DaqService from compilation when NI-DAQmx assemblies aren't available -->
  <ItemGroup Condition="'$(NIDAQmxAvailable)' != 'true'">
    <Compile Remove="Service/DaqService.cs" />
  </ItemGroup>

</Project>
