@page "/settings"
@rendermode InteractiveServer
@using RGMS.Lib.Data
@using RGMS.Lib.Service
@inject ISettingsStore SettingsStore
@inject IDaqService DaqService
@implements IAsyncDisposable

<PageTitle>설정</PageTitle>

<h1>설정</h1>

@if (_daq is null || _phase is null)
{
    <p><em>불러오는 중...</em></p>
}
else
{
    <section class="mb-4">
        <h3>DAQ 보드 연결</h3>
        <div class="d-flex align-items-center gap-3 mb-3">
            <span>상태:</span>
            <span class="badge @StateBadgeClass(DaqService.State)">@DaqService.State</span>
            @if (_lastFault is not null)
            {
                <span class="text-danger small">⚠ @_lastFault</span>
            }
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label" for="deviceName">디바이스</label>
                <div class="input-group">
                    @if (_manualDeviceInput)
                    {
                        <input id="deviceName" class="form-control" @bind="_daq.DeviceName" placeholder="예: Dev1" />
                    }
                    else
                    {
                        <select id="deviceName" class="form-select" @bind="_daq.DeviceName">
                            <option value="">— 디바이스 선택 —</option>
                            @foreach (var d in _devices)
                            {
                                <option value="@d.Name">@d.Name — @d.ProductType (SN: @d.SerialNumber)</option>
                            }
                        </select>
                    }
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="RefreshDevicesAsync" disabled="@_scanning">
                        @(_scanning ? "검색중..." : "새로고침")
                    </button>
                </div>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" id="manualDev" @bind="_manualDeviceInput" />
                    <label class="form-check-label small" for="manualDev">수동 입력 모드</label>
                </div>
                @if (!_manualDeviceInput && _devices.Count == 0 && !_scanning)
                {
                    <div class="form-text text-warning">감지된 디바이스가 없습니다. 보드 연결 후 새로고침을 눌러 주세요.</div>
                }
                else if (!_manualDeviceInput && _devices.Count > 0
                         && !string.IsNullOrEmpty(_daq.DeviceName)
                         && !_devices.Any(d => d.Name == _daq.DeviceName))
                {
                    <div class="form-text text-warning">저장된 디바이스 "@_daq.DeviceName" 가 현재 감지되지 않습니다.</div>
                }
                else if (!_manualDeviceInput && _devices.Count > 0)
                {
                    <div class="form-text">@_devices.Count 개 감지됨</div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-success" @onclick="StartAsync" disabled="@(!CanStart)">Start</button>
            <button class="btn btn-danger" @onclick="StopAsync" disabled="@(!CanStop)">Stop</button>
        </div>
    </section>

    <section class="mb-4">
        <h3>실시간 통계</h3>
        @{ LiveStats? s; lock (_statsLock) { s = _stats; } }
        @if (s is null || DaqService.State != DaqServiceState.Running)
        {
            <p class="text-muted small">(대기 중)</p>
        }
        else
        {
            <div class="small mb-2">
                청크: @s.TotalChunks · 샘플: @s.TotalSamples ·
                실효 @s.EffectiveRateHz.ToString("F1") Hz / 설정 @s.SampleRateHz.ToString("F0") Hz ·
                최종 @s.LastUtc.ToLocalTime().ToString("HH:mm:ss.fff")
            </div>
            <table class="table table-sm table-bordered mb-0">
                <thead><tr><th>채널</th><th>현재</th><th>Min</th><th>Max</th><th>Mean</th></tr></thead>
                <tbody>
                    @for (int i = 0; i < s.ChannelNames.Length; i++)
                    {
                        <tr>
                            <td>@s.ChannelNames[i]</td>
                            <td>@s.Latest[i].ToString("F4")</td>
                            <td>@s.Min[i].ToString("F4")</td>
                            <td>@s.Max[i].ToString("F4")</td>
                            <td>@s.Mean[i].ToString("F4")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="mb-4">
        <h3>샘플링</h3>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="sampleRate">Sample Rate (Hz)</label>
                <input id="sampleRate" type="number" step="1" min="1" class="form-control" @bind="_daq.SampleRateHz" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="spc">Samples per channel / callback</label>
                <input id="spc" type="number" step="1" min="1" class="form-control" @bind="_daq.SamplesPerChannelPerCallback" />
            </div>
        </div>
    </section>

    <section class="mb-4">
        <h3>채널</h3>
        <div class="row g-3">
            @for (var i = 0; i < _channelEdits.Count; i++)
            {
                var idx = i;
                var ch = _channelEdits[idx];
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">CH @idx — @(ch.Name ?? "(unnamed)")</h5>
                            <div class="mb-2">
                                <label class="form-label">Physical Channel</label>
                                <input class="form-control" @bind="ch.PhysicalChannel" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Name</label>
                                <input class="form-control" @bind="ch.Name" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Terminal</label>
                                <select class="form-select" @bind="ch.Terminal">
                                    @foreach (var t in Enum.GetValues<DaqTerminalConfig>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="row g-2">
                                <div class="col">
                                    <label class="form-label">Min (V)</label>
                                    <input type="number" step="0.1" class="form-control" @bind="ch.MinVolts" />
                                </div>
                                <div class="col">
                                    <label class="form-label">Max (V)</label>
                                    <input type="number" step="0.1" class="form-control" @bind="ch.MaxVolts" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="mb-4">
        <h3>Phase 설정</h3>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="gateOn">Gate ON phase (°)</label>
                <input id="gateOn" type="number" step="1" class="form-control" @bind="_phase.GateOnPhaseDeg" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="gateOff">Gate OFF phase (°)</label>
                <input id="gateOff" type="number" step="1" class="form-control" @bind="_phase.GateOffPhaseDeg" />
            </div>
        </div>
    </section>

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">저장</button>
        @if (_savedAt is not null)
        {
            <span class="text-success small">✓ 저장 완료 (@_savedAt.Value.ToLocalTime().ToString("HH:mm:ss"))</span>
        }
        @if (_error is not null)
        {
            <span class="text-danger small">⚠ @_error</span>
        }
    </div>
}

@code {
    private DaqConfiguration? _daq;
    private PhaseConfiguration? _phase;
    private List<ChannelEdit> _channelEdits = new();
    private IReadOnlyList<DaqDeviceInfo> _devices = Array.Empty<DaqDeviceInfo>();
    private bool _busy;
    private bool _scanning;
    private bool _manualDeviceInput;
    private DateTimeOffset? _savedAt;
    private string? _error;
    private string? _lastFault;

    protected override async Task OnInitializedAsync()
    {
        var (daq, phase) = await SettingsStore.LoadAsync();
        ApplyLoaded(daq, phase);

        DaqService.StateChanged += OnDaqStateChanged;
        DaqService.AcquisitionFaulted += OnDaqFaulted;
        DaqService.SamplesAcquired += OnSamplesAcquired;

        await RefreshDevicesAsync();
    }

    private void ApplyLoaded(DaqConfiguration daq, PhaseConfiguration phase)
    {
        _daq = new DaqConfiguration
        {
            DeviceName = daq.DeviceName,
            SampleRateHz = daq.SampleRateHz,
            SamplesPerChannelPerCallback = daq.SamplesPerChannelPerCallback,
            Channels = daq.Channels,
        };
        _phase = new PhaseConfiguration
        {
            GateOnPhaseDeg = phase.GateOnPhaseDeg,
            GateOffPhaseDeg = phase.GateOffPhaseDeg,
        };
        _channelEdits = daq.Channels.Select(c => new ChannelEdit
        {
            PhysicalChannel = c.PhysicalChannel,
            Name = c.Name,
            Terminal = c.Terminal,
            MinVolts = c.MinVolts,
            MaxVolts = c.MaxVolts,
        }).ToList();
    }

    private async Task RefreshDevicesAsync()
    {
        _scanning = true;
        _error = null;
        StateHasChanged();
        try
        {
            _devices = await DaqService.EnumerateDevicesAsync();
        }
        catch (Exception ex)
        {
            _error = $"디바이스 열거 실패: {ex.Message}";
            _devices = Array.Empty<DaqDeviceInfo>();
        }
        finally
        {
            _scanning = false;
        }
    }

    private DaqConfiguration BuildDaq()
    {
        return new DaqConfiguration
        {
            DeviceName = _daq!.DeviceName,
            SampleRateHz = _daq.SampleRateHz,
            SamplesPerChannelPerCallback = _daq.SamplesPerChannelPerCallback,
            Channels = _channelEdits.Select(c => new DaqChannelConfig
            {
                PhysicalChannel = c.PhysicalChannel,
                Name = c.Name,
                Terminal = c.Terminal,
                MinVolts = c.MinVolts,
                MaxVolts = c.MaxVolts,
            }).ToArray(),
        };
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var daq = BuildDaq();
            await SettingsStore.SaveAsync(daq, _phase!);
            _daq = daq;
            _savedAt = DateTimeOffset.UtcNow;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        _lastFault = null;
        try
        {
            var daq = BuildDaq();
            await SettingsStore.SaveAsync(daq, _phase!);
            _daq = daq;
            _savedAt = DateTimeOffset.UtcNow;
            lock (_statsLock) { _stats = null; _lastRenderTicks = 0; }
            await DaqService.StartAsync(daq);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await DaqService.StopAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private bool CanStart => !_busy && DaqService.State is DaqServiceState.Idle or DaqServiceState.Faulted;
    private bool CanStop => !_busy && DaqService.State is DaqServiceState.Running or DaqServiceState.Starting;

    private static string StateBadgeClass(DaqServiceState state) => state switch
    {
        DaqServiceState.Running => "bg-success",
        DaqServiceState.Starting or DaqServiceState.Stopping => "bg-warning text-dark",
        DaqServiceState.Faulted => "bg-danger",
        _ => "bg-secondary",
    };

    private async void OnDaqStateChanged(object? sender, DaqServiceState state)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnDaqFaulted(object? sender, DaqFaultEventArgs e)
    {
        _lastFault = e.Exception.Message;
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        DaqService.StateChanged -= OnDaqStateChanged;
        DaqService.AcquisitionFaulted -= OnDaqFaulted;
        DaqService.SamplesAcquired -= OnSamplesAcquired;
        return ValueTask.CompletedTask;
    }

    private LiveStats? _stats;
    private readonly object _statsLock = new();
    private long _lastRenderTicks;
    private static readonly long RenderThrottleTicks = TimeSpan.FromMilliseconds(200).Ticks;

    private void OnSamplesAcquired(object? sender, DaqSamplesEventArgs e)
    {
        var chCount = e.Samples.GetLength(0);
        var sampleCount = e.Samples.GetLength(1);
        if (chCount == 0 || sampleCount == 0) return;

        bool render;
        lock (_statsLock)
        {
            if (_stats is null || _stats.ChannelNames.Length != chCount)
            {
                _stats = new LiveStats
                {
                    ChannelNames = e.ChannelNames.ToArray(),
                    Latest = new double[chCount],
                    Min = new double[chCount],
                    Max = new double[chCount],
                    Mean = new double[chCount],
                    StartedUtc = e.TimestampUtc,
                    SampleRateHz = e.SampleRateHz,
                };
            }
            for (int c = 0; c < chCount; c++)
            {
                double min = double.PositiveInfinity, max = double.NegativeInfinity, sum = 0;
                for (int sIdx = 0; sIdx < sampleCount; sIdx++)
                {
                    var v = e.Samples[c, sIdx];
                    if (v < min) min = v;
                    if (v > max) max = v;
                    sum += v;
                }
                _stats.Latest[c] = e.Samples[c, sampleCount - 1];
                _stats.Min[c] = min;
                _stats.Max[c] = max;
                _stats.Mean[c] = sum / sampleCount;
            }
            _stats.TotalChunks++;
            _stats.TotalSamples += sampleCount;
            _stats.LastUtc = e.TimestampUtc;
            var elapsed = (e.TimestampUtc - _stats.StartedUtc).TotalSeconds;
            _stats.EffectiveRateHz = elapsed > 0 ? _stats.TotalSamples / elapsed : 0;

            var now = DateTime.UtcNow.Ticks;
            render = now - _lastRenderTicks >= RenderThrottleTicks;
            if (render) _lastRenderTicks = now;
        }
        if (render) _ = InvokeAsync(StateHasChanged);
    }

    private sealed class LiveStats
    {
        public string[] ChannelNames = Array.Empty<string>();
        public double[] Latest = Array.Empty<double>();
        public double[] Min = Array.Empty<double>();
        public double[] Max = Array.Empty<double>();
        public double[] Mean = Array.Empty<double>();
        public long TotalChunks;
        public long TotalSamples;
        public DateTimeOffset LastUtc;
        public DateTimeOffset StartedUtc;
        public double SampleRateHz;
        public double EffectiveRateHz;
    }

    private sealed class ChannelEdit
    {
        public string PhysicalChannel { get; set; } = string.Empty;
        public string? Name { get; set; }
        public DaqTerminalConfig Terminal { get; set; } = DaqTerminalConfig.Rse;
        public double MinVolts { get; set; } = -10.0;
        public double MaxVolts { get; set; } = 10.0;
    }
}
